# demo works without API keys. Set deepseek after adding your own key locally.
MODEL_PROVIDER=demo
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# hash is deterministic lexical demo, NOT semantic embeddings.
# For real semantic retrieval: pip install -e ".[semantic]" then sentence-transformers.
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Or EMBEDDING_PROVIDER=api with a separate embedding service:
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# Empty DATABASE_URL uses local SQLite. Compose supplies PostgreSQL/pgvector.
DATABASE_URL=
GITHUB_TOKEN=
ALLOW_LOCAL_IMPORT=false
